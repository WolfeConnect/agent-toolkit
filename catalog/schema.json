{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WolfeConnect Agent Toolkit Catalog",
  "type": "object",
  "required": ["schema_version", "assets"],
  "properties": {
    "schema_version": { "const": 1 },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "path", "provenance", "validation"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "kind": { "enum": ["standard", "skill", "plugin", "script", "template", "fixture"] },
          "path": { "type": "string" },
          "provenance": { "enum": ["personal-original", "permissive-upstream", "manual-exception"] },
          "validation": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

